# Copy this file to ".env" and change values if needed.
# Every setting starts with PCAPMAN_ and is optional (defaults are in app/core/config.py).

PCAPMAN_ENVIRONMENT=development
PCAPMAN_LOG_LEVEL=INFO
# "json" for machine-readable logs, "console" for easy reading while developing
PCAPMAN_LOG_FORMAT=console
PCAPMAN_HOST=127.0.0.1
PCAPMAN_PORT=8000
# Leave empty to use the default: <backend>/data/pcapman.db
PCAPMAN_DATABASE_URL=
# Set to false to skip the automatic database setup at startup (then run: alembic upgrade head)
PCAPMAN_AUTO_MIGRATE=true
